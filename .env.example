# Development profile; fill only the selected provider's key locally.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Competition profile: change AI_PROVIDER=btc, use BTC key and 768 dimensions.
BTC_API_KEY=
BTC_TEXT_MODEL=gpt-6-luna
BTC_EMBEDDING_MODEL=text-multilingual-embedding-002
# Enable each flag only after the same model/endpoint/protocol was smoke-tested.
BTC_STRUCTURED_VERIFIED=0
BTC_SEARCH_VERIFIED=0
BTC_EMBEDDING_VERIFIED=0
BTC_EMBEDDING_BATCH_VERIFIED=0

# ./setup-parser.sh downloads local layout/table + Vietnamese/English OCR models.
# auto uses Docling when installed, otherwise native PDF with explicit limitations.
DOCUMENT_PARSER=docling
DOCUMENT_OCR=auto
DOCUMENT_OCR_LANGUAGES=vi,en
DOCUMENT_MAX_PAGES=40
DOCUMENT_TIMEOUT=180
DOCUMENT_THREADS=2
